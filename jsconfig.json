{
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true
  },
  "include": [
    "**/*",
    "../next-env.d.ts",
    "../.next/types/**/*.ts"
  ],
  "exclude": [
    "../node_modules",
    "../.next",
    "../out"
  ]
}